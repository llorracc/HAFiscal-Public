% ═══════════════════════════════════════════════════════════════════════════
% TABULAR DATA INCLUSION MACRO (for standalone tables)
% ═══════════════════════════════════════════════════════════════════════════
% Fetch dynamically-generated tabular content from external .ltx files
% This allows standalone tables to compile independently while still
% loading generated content from Code/HA-Models/.../*.ltx files
%
% QE-BASELINE FREEZE (plans/20260611_qe-baseline-freeze-and-candidate-lock_plan.md):
% The canonical generated files hold the frozen QE-published numbers
% (LOCKED_TABLES.manifest). Pipeline runs write `_candidate` siblings
% (see Code/HA-Models/FromPandemicCode/generated_output.py). By default the
% build reads the FROZEN canonical files. To preview candidate results,
% `make pdf-candidate` creates the gitignored flag file
% @local/use-candidate-tables.ltx (containing \usecandidatetablestrue);
% then these macros read `<base>_candidate.<ext>` siblings when they exist,
% falling back to the frozen file when they do not.
% NOTE: this file does \makeatother at the end of its earlier sections, so we
% must re-enable @-names for the internal macros below.
\makeatletter
\newif\ifusecandidatetables
\usecandidatetablesfalse
\providecommand{\latexroot}{.}% normally defined by relpath-to-latexroot.ltx
\InputIfFileExists{\latexroot/@local/use-candidate-tables.ltx}{}{}

% --- Annotated build (U3, owner ruling 2026-08-23: text stays FROZEN; the
% annotated VARIANT badges each exhibit that current code changes, linking to
% UPDATES.md). `make pdf-annotated` creates the flag file; the annotations map
% (@local/updates-annotations.ltx) is GENERATED by Code/HA-Models/updates_report.py
% alongside UPDATES.md -- never hand-edit either. Frozen bytes are read, never
% written; the default build is untouched (flag absent => \annotatedtablesfalse).
\newif\ifannotatedtables
\annotatedtablesfalse
\InputIfFileExists{\latexroot/@local/use-annotated-tables.ltx}{}{}
\InputIfFileExists{\latexroot/@local/updates-annotations.ltx}{}{}
% Badge: typeset AFTER the frozen exhibit when the annotations map knows it.
% #1 = the edef'd include path (key), matched exactly as generated.
\def\hafiscal@updatesbadge#1{%
  \typeout{HFANNOT key check: [#1] \ifcsname HFupd@#1\endcsname FOUND\else absent\fi}%
  \ifcsname HFupd@#1\endcsname
    \par\nobreak\vspace{2pt}%
    {\footnotesize\sffamily\bfseries
     \@ifundefined{textcolor}{}{\color{red!65!black}}%
     [UPDATED\ --- the bug-fixed and improved code change this exhibit; see
      \csname HFupd@#1\endcsname]}\par
    % A FIGURE-LEVEL note (map key HFupdfig@<same path>) is not typeset here: six
    % copies of a 46-word note in the narrow panel badges of a 2x3 figure overflowed
    % the page by 197pt (2026-09-05). It is stored once and fired at \end{figure}.
    \ifcsname HFupdfig@#1\endcsname
      \ifx\hafiscal@fignote\@empty
        \global\expandafter\let\expandafter\hafiscal@fignote\csname HFupdfig@#1\endcsname
      \fi
    \fi
  \fi
  % A note on the TEXT (map key HFupdtext@<same key>): one full-width box, typeset
  % wherever the exhibit badge would go (under the section head for a keyed subfile).
  \ifcsname HFupdtext@#1\endcsname
    \par\nobreak\vspace{2pt}\noindent
    \begin{minipage}{\linewidth}\raggedright\footnotesize\sffamily
      \@ifundefined{textcolor}{}{\color{red!65!black}}%
      {\bfseries [NOTE ON THE TEXT\ --- prose in this section is keyed to results the
       bug-fixed and improved code changes; see UPDATES.md, ``Notes on the text'':]}
      \csname HFupdtext@#1\endcsname
    \end{minipage}\par
  \fi}
\def\hafiscal@fignote{}
\def\hafiscal@fignote@fire{%
  \ifx\hafiscal@fignote\@empty\else
    \par\nobreak\vspace{2pt}\noindent
    \begin{minipage}{\linewidth}\raggedright\footnotesize\sffamily\bfseries
      \@ifundefined{textcolor}{}{\color{red!65!black}}%
      [UPDATED\ --- \hafiscal@fignote]%
    \end{minipage}\par
    \global\let\hafiscal@fignote\@empty
  \fi}

% Hand-maintained wrapper tables render via \subfile{../Tables/<name>} (no
% extension), which bypasses \fetchgeneratedtabular -- so in the annotated
% build we also wrap \subfile: badge the call when the annotations map has a
% key for its arg (checked with and without .tex; unknown args no-op, so
% section-level \subfile{Subfiles/...} calls are untouched unless the map names
% them). Deferred to \AtBeginDocument so the subfiles package has already
% defined \subfile.
%
% Section-head badge (C10 rescoped, owner 2026-08-28 17:10: the online
% appendix's hand-typed tables are never replaced; the annotated build badges
% the appendix at its section head, pointing to the UPDATES.md section, with NO
% hook in the appendix source). A keyed \subfile ARMS a pending badge
% (\hafiscal@headbadge := its key, globally) before the file is read; the first
% \section (starred or not) inside it typesets the badge right under the
% heading and disarms; a keyed file with no \section (a table wrapper) is badged
% after the file, as before. The enclosing file's pending key travels as a
% macro argument through nested \subfile calls, so a keyed table inside a keyed
% section file restores it on return. A standalone compile of a section file
% (Subfiles/X.tex on its own -- how the tracked Subfiles/Appendix-Robustness.pdf
% is made; the subfiles class exposes only \jobname) arms from
% \latexroot/Subfiles/<jobname minus the annotated builds' "-annotated"
% suffix>.tex when the map has that key.
\def\hafiscal@headbadge{}
% A key is "known" when the map carries an exhibit badge (HFupd@) OR a note on the
% TEXT (HFupdtext@, 2026-09-09: prose keyed to changed results, one box under the
% section head; generated from updates_report.TEXT_NOTES). Same arming path.
\newif\ifhafiscal@keyed
\def\hafiscal@ifkeyed#1{%
  \hafiscal@keyedfalse
  \ifcsname HFupd@#1\endcsname\hafiscal@keyedtrue\fi
  \ifcsname HFupdtext@#1\endcsname\hafiscal@keyedtrue\fi}
\let\hafiscal@nil\relax
\begingroup
  \edef\x{\endgroup\long\def\noexpand\hafiscal@stripannot##1\detokenize{-annotated}##2\noexpand\hafiscal@nil{##1}}%
\x
\def\hafiscal@subfile@keyed#1#2{%  #1 = the \subfile arg, #2 = its key in the map
  \expandafter\hafiscal@subfile@keyed@aux\expandafter{\hafiscal@headbadge}{#1}{#2}}
\def\hafiscal@subfile@keyed@aux#1#2#3{%  #1 = the enclosing file's pending key, #2 = arg, #3 = key
  \gdef\hafiscal@headbadge{#3}%
  \hafiscal@orig@subfile{#2}%
  \ifx\hafiscal@headbadge\@empty\else\hafiscal@updatesbadge{#3}\fi
  \gdef\hafiscal@headbadge{#1}}
\def\hafiscal@headbadge@fire{%
  \ifx\hafiscal@headbadge\@empty\else
    \expandafter\hafiscal@updatesbadge\expandafter{\hafiscal@headbadge}%
    \global\let\hafiscal@headbadge\@empty
  \fi}
\def\hafiscal@section@star#1{\hafiscal@orig@section*{#1}\hafiscal@headbadge@fire}
\def\hafiscal@section@plain{\@ifnextchar[\hafiscal@section@opt\hafiscal@section@noopt}
\def\hafiscal@section@opt[#1]#2{\hafiscal@orig@section[#1]{#2}\hafiscal@headbadge@fire}
\def\hafiscal@section@noopt#1{\hafiscal@orig@section{#1}\hafiscal@headbadge@fire}
\def\hafiscal@arm@standalone{%
  \edef\hafiscal@tmp{\jobname\detokenize{-annotated}}%
  \edef\hafiscal@jobstem{\expandafter\hafiscal@stripannot\hafiscal@tmp\hafiscal@nil}%
  \hafiscal@ifkeyed{\latexroot/Subfiles/\hafiscal@jobstem.tex}%
  \ifhafiscal@keyed
    \xdef\hafiscal@headbadge{\latexroot/Subfiles/\hafiscal@jobstem.tex}%
  \fi}
\AtBeginDocument{%
  \ifannotatedtables
    \@ifundefined{subfile}{}{%
      \let\hafiscal@orig@subfile\subfile
      \renewcommand{\subfile}[1]{%
        \hafiscal@ifkeyed{#1.tex}%
        \ifhafiscal@keyed
          \expandafter\@firstoftwo
        \else
          \expandafter\@secondoftwo
        \fi
        {\hafiscal@subfile@keyed{#1}{#1.tex}}%
        {\hafiscal@ifkeyed{#1}%
         \ifhafiscal@keyed
           \expandafter\@firstoftwo
         \else
           \expandafter\@secondoftwo
         \fi
         {\hafiscal@subfile@keyed{#1}{#1}}%
         {\hafiscal@orig@subfile{#1}}}}}%
    \@ifundefined{section}{}{%
      \let\hafiscal@orig@section\section
      \renewcommand{\section}{\@ifstar{\hafiscal@section@star}{\hafiscal@section@plain}}}%
    % Figure-level notes fire once, full width, at the end of the enclosing figure.
    \@ifundefined{endfigure}{}{%
      \let\hafiscal@orig@endfigure\endfigure
      \def\endfigure{\hafiscal@fignote@fire\hafiscal@orig@endfigure}}%
    % float.sty rebinds \endfigure to \float@endH inside every [H] figure
    % (float.sty:79), so hook that end macro as well.
    \@ifundefined{float@endH}{}{%
      \let\hafiscal@orig@floatendH\float@endH
      \def\float@endH{\hafiscal@fignote@fire\hafiscal@orig@floatendH}}%
    \hafiscal@arm@standalone
  \fi}

\providecommand{\candidatesuffix}{_candidate}

% \hafiscal@setcandidate{<canonical path>} -> defines \fetched@cand as the
% `_candidate` sibling path (extension preserved).
\def\hafiscal@setcandidate#1{%
  \edef\fetched@arg{#1}%
  \expandafter\filename@parse\expandafter{\fetched@arg}%
  \edef\fetched@cand{\filename@area\filename@base\candidatesuffix.\filename@ext}%
}

% Usage: \fetchgeneratedtabular{\latexroot/Code/HA-Models/.../table.ltx}
\providecommand{\fetchgeneratedtabular}{}
\renewcommand{\fetchgeneratedtabular}[1]{%
  \ifusecandidatetables
    \begingroup
      \hafiscal@setcandidate{#1}%
      \IfFileExists{\fetched@cand}{%
        \CatchFileDef{\fetchedcontent}{\fetched@cand}{}%
      }{%
        \CatchFileDef{\fetchedcontent}{#1}{}%
      }%
      \fetchedcontent
    \endgroup
  \else
    \CatchFileDef{\fetchedcontent}{#1}{}%
    \fetchedcontent
    \ifannotatedtables
      \begingroup\edef\fetched@arg{#1}%
      \expandafter\hafiscal@updatesbadge\expandafter{\fetched@arg}%
      \endgroup
    \fi
  \fi
}

% Candidate-aware \includegraphics for code-generated figures.
% Usage: \frozenORcandidate[width=.9\textwidth]{\latexroot/Code/.../fig.pdf}
\providecommand{\frozenORcandidate}{}
\renewcommand{\frozenORcandidate}[2][]{%
  \ifusecandidatetables
    \begingroup
      \hafiscal@setcandidate{#2}%
      \IfFileExists{\fetched@cand}{%
        \includegraphics[#1]{\fetched@cand}%
      }{%
        \includegraphics[#1]{#2}%
      }%
    \endgroup
  \else
    \includegraphics[#1]{#2}%
    % Annotated build: badge the panel when the map knows this figure (its key is the
    % same manifest path the tables use); the value links to UPDATES-figures.pdf.
    \ifannotatedtables
      \begingroup\edef\fetched@arg{#2}%
      \expandafter\hafiscal@updatesbadge\expandafter{\fetched@arg}%
      \endgroup
    \fi
  \fi
}
\makeatother
