# ShellCheck configuration for macOS compatibility
# Configure for macOS default bash 3.2 compatibility

# Set shell to bash 3.2 (macOS default)
shell=bash

# Disable warnings for newer bash features not available in bash 3.2, and pedantic style warnings
# SC2207: Prefer mapfile/readarray (not available in bash 3.2)
# SC2250: Prefer putting braces around variable references (pedantic style)
# SC2312: Consider invoking this command separately (pedantic style)
# SC2181: Check exit code directly (pedantic style)
# SC2034: Variable appears unused (often false positives)
# SC2155: Declare and assign separately (verbose but not critical)
# SC1091: Not following sourced files (informational, not an error)
# SC2317: Command appears to be unreachable (false positive for return||exit pattern)
disable=SC2207,SC2250,SC2312,SC2181,SC2034,SC2155,SC1091,SC2317

# Keep important functional checks enabled 