	<script type="text/javascript">
		function modalCloseHandler(helpTerm,elem){
	    $('#helpViewDivId').unbind('hidden.bs.modal');
		$('#helpViewDivId').on('hidden.bs.modal', function (e) {
				$(elem).focus();
		});
		}
		function displayHelp(helpTerm,elem){
			ReactDOM.render(React.createElement(HelpViewer, {modalId:'helpViewDivId', helpTerm:helpTerm, context: 'pcms', application:'openicpsr',module:null,appUrl:'https://deposit.icpsr.umich.edu/deposit'}), document.getElementById('helpViewDiv'));
			$('#helpViewDivId').on('shown.bs.modal', function (e) {
				$('#helpViewDivId .modal-header .close').focus();
				modalCloseHandler(helpTerm,elem);
			});
			$('#helpViewDivId').modal('show');
		}
	</script>
	<script type="text/javascript">
		function approveDisapproveModal(projectId, versionNumber) {
			$("#approveDisapproveDialog").modal().show();
		}
		

		function approveOrDisapprove() {
			var projectId = "122884";
			var versionNumber = "V1";
			var approveDisapproveValue = $("input[name='approveDisapproveSelection']:checked").val();
			var reason = $("#reason").val();
			
			$.ajax({
				url: "https://deposit.icpsr.umich.edu/deposit/review/approveDisapproveAction",
				crossDomain: true,
				dataType: "text",
				data: {projectId: projectId, versionNumber: versionNumber, approveDisapprove: approveDisapproveValue, reason:reason},
				type: "POST",
				success: function(data) {
					$("#approvalWell").hide();
				},
				error: function(xhr, status, err) {
					console.log(err);
				}
			})
		}
		
	</script>
	<script>
		var jwtToken = null;
		$(document).ready(function (e) {
			jwtToken = '';
			$(document).ajaxSend(function(event, jqxhr, settings) {
				jqxhr.setRequestHeader("Authorization", "Bearer " + jwtToken);
			});
			

			// test for presence of request button
			if($( "a#restrictedDataRequestButton" ).length){
				// FIXME This may 
				// attach a click event to the request link for restricted data
				$("a#restrictedDataRequestButton").click(function(e){
					e.preventDefault();
					window.setTimeout( function(){
						window.location = $(this).attr('href');
					}, 500 );
				});
			}
						
		});

		function updatePager(pageSelected, pageSize, sortOrder, sortAsc) {
			var newUrl = '/openicpsr' + '/project/122884/version/V1/view?flag=follow&path=/openicpsr/122884/fcr:versions/V1/raw/SCF_precompiled/scfp2004s.zip&type=file' 
							+ ((pageSelected !=null) ? ('&pageSelected=' + pageSelected) : '') + ((pageSize !=null) ? ('&pageSize=' + pageSize) : '' ) 
							+ ((sortOrder !=null) ? ('&sortOrder=' + sortOrder) : '') + ((sortAsc != null) ? ('&sortAsc=' + sortAsc) : '') ;
			window.location.href = newUrl;
		}

		function showObjectPreview(path, type) {
			ReactDOM.render(React.createElement(ObjectViewDialog, {
				path: path.trim(),
				type: type
			}), document.getElementById('objectPreviewTag'));
		};

	</script>
